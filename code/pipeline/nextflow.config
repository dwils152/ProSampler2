manifest {
    name = 'project-template'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04.6'
}

params {
    run_id = null
    outdir = null
    // Set by the runner to the main checkout's code/data, also from worktrees.
    data_dir = null
}

includeConfig 'conf/local.config'

profiles {
    local {}
    slurm { includeConfig 'conf/slurm.config' }
}

// The runner enables reporting with explicit paths in execution.config.
trace.enabled = false
report.enabled = false
timeline.enabled = false
