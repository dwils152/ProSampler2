params {
    workflow_name = 'example'
    seed = 42
    sample_count = 32
    driver_timeout_seconds = 900
    parquet_threads = 1
    parquet_memory_limit = '256MB'
    expected_outputs = ['example/samples.csv', 'example/samples.parquet', 'example/summary.json']
    // Synthetic provenance only; replace with real dataset/split versions and
    // biological units when implementing a scientific workflow.
    dataset_id = 'synthetic-uniform-generator-v1'
    split_id = 'not-applicable-synthetic'
    biological_unit = 'not-applicable-synthetic'
    evaluation_id = 'example-summary-v1'
    catalog_metrics = [
        [name: 'count', path: 'example/summary.json', key: 'count', unit: 'draws', definition_id: 'sample-count-v1'],
        [name: 'mean', path: 'example/summary.json', key: 'mean', unit: 'dimensionless', definition_id: 'arithmetic-mean-v1'],
        [name: 'minimum', path: 'example/summary.json', key: 'minimum', unit: 'dimensionless', definition_id: 'sample-minimum-v1'],
        [name: 'maximum', path: 'example/summary.json', key: 'maximum', unit: 'dimensionless', definition_id: 'sample-maximum-v1']
    ]
}
