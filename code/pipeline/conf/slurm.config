// Set queue, clusterOptions and site resource limits here before HPC use.
// With queue unset, Slurm uses the site's default partition.
process {
    executor = 'slurm'
    queue = null
    cpus = 1
    memory = 2.GB
    time = 10.m
    errorStrategy = 'terminate'
    maxRetries = 0
}
executor.queueSize = 2
